{
    "type": "module",
    "main": "./dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "build": "npm run copy-shared-types && tsc -p tsconfig.json",
        "dev": "npm-run-all --parallel dev:start dev:watch:copy-shared-types",
        "dev:start": "ts-node src/server.ts",
        "copy-shared-types": "rsync -av --include='*/' --include='*.ts' --exclude='*' ../../shared/ src/shared-types/ && node scripts/fix-imports.cjs",
        "dev:watch:copy-shared-types": "nodemon --quiet --watch ../../shared --ext ts --exec 'npm run copy-shared-types'"
    },
    "dependencies": {
        "cookie": "^0.6.0",
        "node-fetch": "^3.3.2",
        "openai": "^5.9.0"
    },
    "devDependencies": {
        "@types/cookie": "^0.6.0",
        "nodemon": "^3.1.10",
        "npm-run-all": "^4.1.5"
    }
}
